@startuml residence
title Diagramme de classe pour la gestion des résidences universitaires.
class Etudiant{
     -matricule:string
     -nom:string
     -prenom:string
     +infopersonnel():void  
}
class Chambre{
     -numero:int
     -capacite:int
     -nbreOccupant:int
     +occuper():void
     +libre():void
     +placeLibre():void

}
class Batiment{
     -nom:string
     -chambre:vector<Chambre>
     +placeDisponible():void
     +ajouterChambre():void
}
class Demande{
     - id : int
     - matricule : string
     - statut : StatutDemande
     + accepter():void
     + refuser():void

}
class Attribution{
     - id :int
     - matricule :string
     - chambre :string
     - entree/sortie :string
     + estEnCours():void
     +cloture():void
}
class Residence{
     -nom:string
     -batiment:vector<Batiment>
     -etudiant:vector<Etudiant>
     -demandes:vector<Demande>
     + ajouterBatiment():void
     + enregistrerDemande():void
     + attribuerChambre():void
     + enregistrerDepart():void
     +tauxOccupation():void
}
@enduml
Residence--Batiment
Etudiant--Batiment
Batiment--Demande
Batiment--Chambre
Etudiant--Attribution
Chambre--Attribution