@startuml TP3_Cas_Utilisation_Residence

left to right direction
title Diagramme de cas d'utilisation - TP3 : Gestion d'une résidence universitaire

actor "Étudiant" as Etudiant
actor "Gestionnaire de résidence" as Gestionnaire

rectangle "Système de gestion d'une résidence universitaire" {

    usecase "Soumettre une demande
d'hébergement" as UC_Demande
    usecase "Consulter le statut
de sa demande" as UC_Statut

    usecase "Consulter les chambres
libres et occupées" as UC_ConsulterChambres
    usecase "Enregistrer une demande" as UC_EnregistrerDemande
    usecase "Traiter une demande" as UC_TraiterDemande
    usecase "Accepter une demande" as UC_Accepter
    usecase "Refuser une demande" as UC_Refuser

    usecase "Vérifier les places
disponibles" as UC_VerifierPlaces
    usecase "Attribuer une chambre" as UC_Attribuer
    usecase "Vérifier qu'aucune autre
attribution n'est en cours" as UC_VerifierAttribution
    usecase "Enregistrer le départ
d'un étudiant" as UC_Depart

    usecase "Consulter l'historique
des attributions" as UC_Historique
    usecase "Consulter les statistiques
et le taux d'occupation" as UC_Statistiques
}

Etudiant -- UC_Demande
Etudiant -- UC_Statut
Etudiant -- UC_ConsulterChambres

Gestionnaire -- UC_ConsulterChambres
Gestionnaire -- UC_EnregistrerDemande
Gestionnaire -- UC_TraiterDemande
Gestionnaire -- UC_Attribuer
Gestionnaire -- UC_Depart
Gestionnaire -- UC_Historique
Gestionnaire -- UC_Statistiques

UC_Demande ..> UC_EnregistrerDemande : <<include>>
UC_TraiterDemande ..> UC_Accepter : <<extend>>
UC_TraiterDemande ..> UC_Refuser : <<extend>>
UC_Attribuer ..> UC_VerifierPlaces : <<include>>
UC_Attribuer ..> UC_VerifierAttribution : <<include>>

@enduml
